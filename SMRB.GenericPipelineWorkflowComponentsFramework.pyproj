<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>7aa91d7b-18a4-42bd-acc0-bcdb057a564f</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <!-- This is a reusable package project, not an executable application. -->
    <StartupFile></StartupFile>
    <SearchPath>src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>..\bin\SMRB.GenericPipelineWorkflowComponentsFramework\</OutputPath>
    <BaseIntermediateOutputPath>..\bin\Intermediates\SMRB.GenericPipelineWorkflowComponentsFramework\</BaseIntermediateOutputPath>
    <Name>SMRB.GenericPipelineWorkflowComponentsFramework</Name>
    <RootNamespace>smrb_generic_pipeline_workflow_components_framework</RootNamespace>
    <!-- Use this project's isolated Python environment; keep it independent of the solution-wide environment. -->
    <InterpreterId>MSBuild|SMRB.GenericPipelineWorkflowComponentsFramework.Python3151|$(MSBuildProjectFullPath)</InterpreterId>
    <InterpreterArguments>-s</InterpreterArguments>
    <SuppressEnvironmentCreationPrompt>True</SuppressEnvironmentCreationPrompt>
    <SuppressPackageInstallationPrompt>True</SuppressPackageInstallationPrompt>
    <TestFramework>none</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SMRB.GenericPipelineWorkflowComponentsFramework.py" />
    <Compile Include="src\**\*.py" />
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\" />
    <Folder Include="tests\" />
    <Folder Include="tests\architecture\" />
    <Folder Include="tests\core\" />
    <Folder Include="tests\integrations\" />
    <Folder Include="tests\public_api\" />
    <Folder Include="tests\core\processing_units\" />
    <Folder Include="tests\core\stage\" />
    <Folder Include="tests\core\step\" />
    <Folder Include="tests\core\supporting_patterns\" />
    <Folder Include="tests\core\processing_units\spu\" />
    <Folder Include="tests\core\supporting_patterns\error_handling\" />
    <Folder Include="tests\core\supporting_patterns\observation\" />
    <Folder Include="tests\core\supporting_patterns\validation\" />
    <Folder Include="tests\integrations\prefect\" />
    <Folder Include="tests\integrations\prefect\bindings\" />
    <Folder Include="tests\integrations\prefect\correlation\" />
    <Folder Include="tests\integrations\prefect\invocation\" />
    <Folder Include="tests\integrations\prefect\results\" />
    <Folder Include="tests\public_api\core\" />
    <Folder Include="tests\public_api\integrations\" />
    <Folder Include="tests\public_api\integrations\prefect\" />
    <Content Include="README.md" />
    <Compile Include="tests\**\*.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".env\">
      <Id>SMRB.GenericPipelineWorkflowComponentsFramework.Python3151</Id>
      <Version>3.15.1</Version>
      <Description>SMRB.GenericPipelineWorkflowComponentsFramework project-local Python 3.15.1 virtual environment</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <LibraryPath>Lib\</LibraryPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Python is interpreted; Build prepares the project output without inventing an executable entry point. -->
  <Target Name="CoreCompile" />
  <Target Name="BeforeBuild">
    <MakeDir Directories="$(OutputPath)" />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
  </Target>
  <Target Name="AfterBuild"></Target>
</Project>