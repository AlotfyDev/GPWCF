digraph "01_SPU_Step_Processing_Unit" {
  rankdir=TB;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  label="01 SPU Step Processing Unit Class Diagram";
  labelloc=t;

  "SPU_Error_Type_Definition_Registration" [label="{SPU Error Type Definition Registration|Feature / Responsibility|SPUError\lSPUErrorTypeDefinition}", tooltip="Each concrete SPU defines and registers its own SPUErrorTypeDefinition instances through the SPUErrorTypeDefinitionRegistry instance assigned to it by the Pipeline."];
  "Domain_Native_Identity_Correlation" [label="{Domain/Native Identity Correlation|Feature / Concept}", tooltip="Correlation between GPWCF domain identities (Pipeline, Stage, Step, SPU, invocation) and Prefect native identities (Flow Run IDs, Task Run IDs, Deployment IDs); neither namespace substitutes for the o"];
  "SPU_Error_Occurrence_Creation" [label="{SPU Error Occurrence Creation|Feature / Responsibility|SPUError}", tooltip="The SPU creates SPUError occurrences for errors arising within its own processing responsibility and makes them available to the owning Step Composition."];
  "Step_Composition_SPU_Caller_Relationship" [label="{Step Composition - SPU Caller Relationship|Feature / Relationship|SPUExecutionResult}", tooltip="The concrete owning Step Composition selects and invokes the SPU, supplies its specialized input/dependencies, and consumes SPUExecutionResult; owns internal composition and flow decisions involving t"];
  "Typed_Result_Preservation" [label="{Typed Result Preservation|Feature / Result Handling|StepExecutionResult\lSPUExecutionResult\lStageResult}", tooltip="Preservation of typed domain results (SPUExecutionResult, StepExecutionResult, StageResult) through Prefect execution without replacing them with Prefect operational State; Prefect State is operationa"];
  "SPU_Functional_Prefect_Binding_Native_Task" [label="{SPU Functional Prefect Binding - Native Task|Feature / Pattern Binding}", tooltip="Each bounded SPU invocation maps to a native Prefect Task inside its owning Step Subworkflow; Prefect executes the Task while Step Composition remains authoritative for invocation meaning, permitted c"];
  "SPU_Entity_versus_Prefect_Task_versus_Prefect_Task_Run" [label="{SPU Entity versus Prefect Task versus Prefect Task Run|Feature / Conceptual Distinction}", tooltip="The deliberate distinction among SPU Entity (domain processing entity), SPU callable implementation, Prefect Task (native execution element), and Prefect Task Run (operational record)."];
  "SPU_Identity_and_Invocation_Correlation" [label="{SPU Identity and Invocation Correlation|Feature / Concept}", tooltip="SPU identity and invocation correlation are maintained across the Step Subworkflow boundary; SPU and invocation identities remain distinct from Step/Stage and native runtime identities."];
  "PHASE_01_02_Qualification_Limits" [label="{PHASE-01/02 Qualification Limits|Feature / Evidence Boundary}", tooltip="The exact PHASE-01/02 evidence and qualification limits: native hierarchy qualification, same-host two-worker deployment qualification, nondeterministic Stage sibling overlap, serialized Step sibling "];
  "SPUExecutionResult_Mapping_and_Preservation" [label="{SPUExecutionResult Mapping and Preservation|Feature / Result Handling|SPUExecutionResult}", tooltip="The binding returns the exact SPUExecutionResult without replacing it with Prefect State; SPU constructs and returns the structured result consumed by Step Composition."];
  "Structured_Results_versus_Exceptions_versus_Prefect_Operational_State" [label="{Structured Results versus Exceptions versus Prefect Operational State|Feature / Conceptual Distinction|SPUExecutionResult}", tooltip="Separation of returned structured results, thrown exceptions, and Prefect operational State; exceptions that prevent SPUExecutionResult return are not an SPUExecutionResult."];
  "Domain_vs_Prefect_Operational_Identity_Namespaces" [label="{Domain vs Prefect Operational Identity Namespaces|Feature / Conceptual Distinction}", tooltip="Separation of domain and Prefect operational identity namespaces: domainNamespace (PipelineInvocationIdentity, StageIdentity, StepIdentity, SPUIdentity, ...) vs prefactNamespace (PipelineFlowRunId, St"];
  "Prefect_Native_Hierarchy_Topology" [label="{Prefect Native Hierarchy Topology|Feature / Topology}", tooltip="GPWCF-to-Prefect boundary mapping: Pipeline Root -> Native Flow, Stage -> Stage Parent Flow, Step -> Step Subflow, SPU -> Native Task. Uses invoke_stage and invoke_step dispatch Tasks as invocation me"];
  "SPUExecutionResult_TOutput" [label="{SPUExecutionResult[TOutput]|Class / Generic Type|TParams: TOutput}", tooltip="Structured aggregate result produced by StepProcessingUnit[TInput,TOutput] and consumed by the owning Step Composition; carries the processing artifact and SPU-invocation-scoped structured results/evi"];
  "Prefect_Integration_Binding_Wave_5_Artifact_1" [label="{Prefect Integration Binding (Wave 5 Artifact 1)|Architectural Design / Feature}", tooltip="Wave 5 detailed design (artifact 1) defining the Prefect 3.9.2 integration boundary that binds GPWCF's runtime-independent Stage, Step, SPU, and selected Supporting Pattern contracts to Prefect-native"];
  "SPU_Functional_Binding" [label="{SPU Functional Binding|Architectural Design / Feature}", tooltip="Wave 3 detailed design (artifact 1) defining how a concrete Step Processing Unit is functionally bound to Prefect's native execution model while preserving the SPU as the actual domain processing enti"];
  "Domain_to_Native_Invocation_Mapping" [label="{Domain-to-Native Invocation Mapping|Feature / Mapping}", tooltip="Mapping of Stage, Step, SPU, and Supporting Pattern invocations to native Flow/Task runs; defines how each GPWCF invocation boundary corresponds to a Prefect-native execution construct while preservin"];
  "Stage_Step_SPU_Invocation_and_Typed_Result_Contracts" [label="{Stage/Step/SPU Invocation and Typed Result Contracts|Feature / API Contract}", tooltip="Stage/Step/SPU invocation and typed result contracts match detailed designs in Waves 1-3; Stage, Step, and SPU callable/result signatures align with Wave 1-3 detailed designs."];
  "Domain_Identity_versus_Prefect_Operational_Identity" [label="{Domain Identity versus Prefect Operational Identity|Feature / Conceptual Distinction}", tooltip="GPWCF domain identities (Pipeline, Stage, Step, SPU, invocation) remain separate from Prefect Flow Run IDs and Task Run IDs. Prefect State is operational execution evidence, not a domain result."];
  "Required_Governing_Artifact_Changes_Dependency_and_Public_API_Architecture" [label="{Required Governing Artifact Changes - Dependency_and_Public_API_Architecture|Feature / Change Control|StepExecutionResult\lStageResult\lStepInvocation\lStageInvocation\lDiagnostic}", tooltip="Update Core Public API contract groups to include StageCallable/StageInvocation/StageResult, StepInvocation/StepExecutionResult/OptionalResultContributions, generic SPU result types, and canonical ide"];
  "SPUErrorTypeDefinition_TErrorContent_THandlingAction" [label="{SPUErrorTypeDefinition[TErrorContent, THandlingAction]|Class / Generic Type|TParams: TErrorContent, THandlingAction}", tooltip="SPU-level error type definition owned by one concrete SPU; TErrorContent describes the error type's meaning/domain characteristics, THandlingAction describes the associated handling action."];
  "Parent_Child_Correlation" [label="{Parent/Child Correlation|Feature / Mapping}", tooltip="Parent/child correlation between Pipeline Root Flow Run, Stage Flow Run, Step Subflow Flow Run, and SPU Task Run; synthetic deployment/subflow invocation records create indirect parent linkage chains "];
  "SPUError_TErrorOccurrenceContext" [label="{SPUError[TErrorOccurrenceContext]|Class / Generic Type|SPUError\lSPUErrorTypeDefinition\lTParams: TErrorOccurrenceContext}", tooltip="SPU-level error occurrence representing one actual occurrence of an error within an SPU; references exactly one registered SPUErrorTypeDefinition and carries occurrence-specific information via TError"];
  "SPUErrorTypeDefinitionRegistry_TErrorTypeDefinition" [label="{SPUErrorTypeDefinitionRegistry[TErrorTypeDefinition]|Class / Generic Type|SPUError\lSPUErrorTypeDefinition\lTParams: TErrorTypeDefinition}", tooltip="SPU-level registry that stores and resolves SPUErrorTypeDefinition instances for exactly one owning SPU; exclusively owned and allocated by the Pipeline per SPU."];
  "Result_Elements_Optionality_Rule" [label="{Result Elements Optionality Rule|Feature / Contract Rule}", tooltip="All elements are independently optional; absence is not a success/failure status. Absence means the corresponding value was not included; the concrete Step defines applicability and interpretation."];
  "StageErrorTypeDefinition_TErrorContent_THandlingAction" [label="{StageErrorTypeDefinition[TErrorContent, THandlingAction]|Class / Generic Type|SPUError\lSPUErrorTypeDefinition\lTParams: TErrorContent, THandlingAction}", tooltip="Stage-level error type definition owned by one concrete Stage; distinct programmatic type from SPUErrorTypeDefinition (neither is alias or subtype of the other)."];
  "SPUExecutionResult_Preservation_Invariant" [label="{SPUExecutionResult Preservation Invariant|Feature / Contract Rule|SPUExecutionResult}", tooltip="Every result element actually produced and available under the SPU invocation contract must be preserved in the returned SPUExecutionResult; a later internal failure must not discard an earlier result"];
  "SPUExecutionResult_Exception_Boundary" [label="{SPUExecutionResult Exception Boundary|Feature / Contract Rule|SPUError\lSPUExecutionResult}", tooltip="An exception that prevents execute from returning is not an SPUExecutionResult; no universal conversion from exceptions to SPUError occurrences or structured result elements is imposed."];
  "Error_Type_Definition" [label="{Error Type Definition|Entity / Concept}", tooltip="Conceptual entity describing a specialized kind of error that may occur within its owning SPU or Stage; registered before being referenced by occurrences; not itself an Error Occurrence."];
  "SPUExecutionResult_Assembly_Rules" [label="{SPUExecutionResult Assembly Rules|Feature / Contract Rule|StepExecutionResult}", tooltip="The SPU assembles only its own invocation-level result; does not assemble StepExecutionResult or decide the Step's next flow transition; Step Composition consumes returned values and performs cross-SP"];
  "Error_Registry" [label="{Error Registry|Entity / Concept}", tooltip="Conceptual entity that stores and resolves Error Type Definitions for exactly one owning SPU or Stage; SPU-level and Stage-level registries are distinct programmatic types."];
  "Core_Public_API_Surface" [label="{Core Public API Surface|Class / API Surface}", tooltip="Core Public API (PUBLIC-CORE) with namespace gpwcf.public_api.core; owner: GPWCF Core; availability: Always available, no Prefect dependency; exposes Stage/Step/SPU callable and result contracts."];
  "Step_Entity_Aggregate_Root" [label="{Step Entity / Aggregate Root|Class / Entity}", tooltip="A Stage-composable processing and orchestration component that exposes a stable callable contract to its owning Stage while internally coordinating its specialized Step Processing Units and applicable"];
  "Step_Processing_Unit_SPU_Entity" [label="{Step Processing Unit (SPU) Entity|Class / Entity}", tooltip="The actual specialized processing unit that performs one assigned processing responsibility inside its owning Step. Not a delegation-only wrapper and not the Step Aggregate."];
  "StepProcessingUnit_TInput_TOutput" [label="{StepProcessingUnit[TInput,TOutput]|Class / Generic Type|TParams: TInput,TOutput}", tooltip="Generic callable contract of the SPU; each concrete SPU binds TInput and TOutput to the types required by its own Step responsibility. No common concrete input or output type across Steps is imposed."];
  "Stage_Composition_Owns_Step_Membership" [label="{Stage Composition Owns Step Membership|Feature / Responsibility}", tooltip="Stage Composition coordinates Step public contracts only; Step Composition coordinates SPUs and selected Supporting Units. Composition is an aggregate responsibility owned by the Entity/Aggregate whos"];
  "SPU_Step_Dependency_Direction" [label="{SPU/Step Dependency Direction|Feature / Dependency Rule}", tooltip="Step Composition to SPU contract only; SPU has no reverse package dependency on Step. SPU package is independently callable processing Entity, not a Step subfolder."];
  "Reference_Consumer_SMRB_PayloadDescriptionGenerator" [label="{Reference Consumer (SMRB.PayloadDescriptionGenerator)|Entity / Reference}", tooltip="Reference consumer for target-specific integration design and end-to-end acceptance; 13 specified stages (STG-01 through STG-13). Stage Model objectives and execution_steps are not presumed to be GPWC"];
  "SPU_Validator_Unit_Contract_Step_Supporting_Validator_Unit" [label="{SPU Validator Unit Contract (Step Supporting Validator Unit)|Class / Component|StepExecutionResult\lSPUExecutionResult\lSPUValidatorResult\lvalidatorResult}", tooltip="Optional supporting pattern selected by a concrete Step for validation responsibilities; retains specialized behavioral and result semantics; validation conclusions remain domain results, not automati"];
  "SPU_Observation_Unit_Contract_Step_Supporting_Observation_Unit" [label="{SPU Observation Unit Contract (Step Supporting Observation Unit)|Class / Component|StepExecutionResult\lAssociation}", tooltip="Optional supporting pattern for observation activity (call, callback, sampling, subscription) against Step-owned target scopes; observation records remain independent of StepExecutionResult and preser"];
  "Step_Public_Callable_Boundary" [label="{Step Public Callable Boundary|Feature / Boundary}", tooltip="Stage-facing facade boundary that exposes Step capability without exposing internal component topology. Stage sees only public input/output contract and Step-level result; Stage does not invoke SPUs o"];
  "Generic_SPU_Result_Types_Contract_Group" [label="{Generic SPU Result Types Contract Group|Feature / API Contract Group|StepExecutionResult\lSPUExecutionResult}", tooltip="Core Public API contract group covering generic SPU result types; SPUExecutionResult[TOutput] remains distinct from StepExecutionResult."];
  "SPU_Input_Contract" [label="{SPU Input Contract|Feature / Contract Rule}", tooltip="The supplied input must conform to the concrete SPU's TInput type; the generic contract does not prescribe internal structure, ownership model, mutability, lifetime, or pass-by semantics of TInput."];
  "SPU_Task_Binding" [label="{SPU Task Binding|Feature / Pattern Binding|StepExecutionResult\lSPUExecutionResult}", tooltip="Native Prefect realization of SPU execution as a Prefect Task inside the owning Step Subflow; SPU Tasks submit to the Step Flow's ThreadPoolTaskRunner and join their futures; SPUExecutionResult remain"];
  "StepComposition_Internal_Orchestration" [label="{StepComposition Internal Orchestration|Feature / Responsibility}", tooltip="Owns internal component composition and Step-specific orchestration decisions; selects and coordinates SPUs and supporting-unit instances; preserves invocation-scoped facts/results/exceptions/custody;"];
  "SPU_Output_Contract" [label="{SPU Output Contract|Feature / Contract Rule|StepExecutionResult\lSPUExecutionResult}", tooltip="Return SPUExecutionResult[TOutput] for a normally completed invocation, preserving results and evidence assigned to this SPU's invocation contract; the SPU does not assemble StepExecutionResult or dec"];

  "SPU_Error_Type_Definition_Registration" -> "SPUErrorTypeDefinition_TErrorContent_THandlingAction" [label="assoc", style=dashed];
  "SPU_Error_Type_Definition_Registration" -> "SPUErrorTypeDefinitionRegistry_TErrorTypeDefinition" [label="assoc", style=dashed];
  "SPU_Error_Occurrence_Creation" -> "SPUError_TErrorOccurrenceContext" [label="assoc", style=dashed];
  "Step_Composition_SPU_Caller_Relationship" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "Typed_Result_Preservation" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPUExecutionResult_Mapping_and_Preservation" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "Structured_Results_versus_Exceptions_versus_Prefect_Operational_State" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPUExecutionResult_TOutput" -> "StepProcessingUnit_TInput_TOutput" [label="assoc", style=dashed];
  "SPUError_TErrorOccurrenceContext" -> "SPUErrorTypeDefinition_TErrorContent_THandlingAction" [label="assoc", style=dashed];
  "SPUErrorTypeDefinitionRegistry_TErrorTypeDefinition" -> "SPUErrorTypeDefinition_TErrorContent_THandlingAction" [label="assoc", style=dashed];
  "StageErrorTypeDefinition_TErrorContent_THandlingAction" -> "SPUErrorTypeDefinition_TErrorContent_THandlingAction" [label="assoc", style=dashed];
  "SPUExecutionResult_Preservation_Invariant" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPUExecutionResult_Exception_Boundary" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPUExecutionResult_Exception_Boundary" -> "SPUError_TErrorOccurrenceContext" [label="assoc", style=dashed];
  "SPU_Validator_Unit_Contract_Step_Supporting_Validator_Unit" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "Generic_SPU_Result_Types_Contract_Group" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPU_Task_Binding" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
  "SPU_Output_Contract" -> "SPUExecutionResult_TOutput" [label="assoc", style=dashed];
}
