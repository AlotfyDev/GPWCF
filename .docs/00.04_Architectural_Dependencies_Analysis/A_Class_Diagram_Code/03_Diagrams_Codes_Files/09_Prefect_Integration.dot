digraph "09_Prefect_Integration" {
  rankdir=TB;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  label="09 Prefect Integration Class Diagram";
  labelloc=t;

  "Invocation_Translation" [label="{Invocation Translation|Feature / Responsibility}", tooltip="Translation of GPWCF domain invocations to native Prefect Flow/Task run invocations while preserving domain identity, invocation acceptance, and result semantics; dispatch Tasks carry no GPWCF busines"];
  "Minimal_Prefect_Integration_Dependency_Policy" [label="{Minimal Prefect Integration Dependency Policy|Feature / Dependency Policy}", tooltip="Minimal Prefect Integration direct/transitive dependency policy; the 106-package environment snapshot is not treated as the minimal Integration dependency closure; minimal transitive lock remains a re"];
  "Installation_Profiles_and_Environment_Isolation" [label="{Installation Profiles and Environment Isolation|Feature / Policy}", tooltip="Installation profiles and environment isolation guarantees ensure Core-only installation works without Prefect; build backend dependencies remain isolated from runtime dependencies."];
  "Prefect_Binding_API_Group" [label="{Prefect Binding API Group|Feature / API Group}", tooltip="Prefect Integration Public API group exposing supported Prefect-specific binding contract; no Prefect imports or types in Core Public API."];
  "Prefect_Configuration_API_Group" [label="{Prefect Configuration API Group|Feature / API Group}", tooltip="Prefect Integration Public API group exposing supported Prefect configuration contract; configuration ownership held by integration package."];
  "Prefect_Correlation_API_Group" [label="{Prefect Correlation API Group|Feature / API Group}", tooltip="Prefect Integration Public API group exposing supported Prefect correlation contract; domain/native identity correlation preserved without conflating namespaces."];
  "Single_Distribution_Optional_Extra_Packaging" [label="{Single-Distribution Optional-Extra Packaging|Feature / Packaging Decision}", tooltip="Replaces unresolved distribution arrangement with one distribution and optional Prefect extra for the initial release; preserves the Core-only installation/import guarantee."];
  "Future_Split_Distribution_Condition" [label="{Future Split Distribution Condition|Feature / Policy}", tooltip="A future split distribution (Core vs Prefect Integration) requires an explicit release/dependency rationale and compatibility policy; not done at initial release."];
  "Integration_Public_API_Boundary" [label="{Integration Public API Boundary|Feature / API Boundary}", tooltip="Configuration ownership and integration Public API boundary; Core must remain usable with Prefect absent; no Prefect types leak into Core API; Public API is an explicit curated stable boundary under p"];
  "Configuration_Ownership" [label="{Configuration Ownership|Feature / Responsibility}", tooltip="Configuration ownership for the integration package; defines how integration configuration is held and applied without creating a universal scheduler, dispatcher, worker manager, deployment manager, o"];
  "Conformance_Requirement_PKG_001" [label="{Conformance Requirement PKG-001|Feature / Conformance Rule}", tooltip="The initial release uses one gpwcf distribution with a rigorously optional Prefect extra."];
  "Prefect_Transitive_Lock_Release_Gate" [label="{Prefect Transitive Lock Release Gate|Feature / Release Gate}", tooltip="The exact Prefect transitive lock and clean isolated build verification remain explicit release gates; Prefect 3.9.2 preserved as optional runtime extra."];
  "Dependency_Graph_Acyclicity" [label="{Dependency Graph Acyclicity|Feature / Constraint}", tooltip="Dependency graph is acyclic and all forbidden dependency directions remain prohibited across Core, optional Supporting Patterns, Prefect Integration, consumers, and SMRB development environment."];
  "Conformance_Requirement_PKG_003" [label="{Conformance Requirement PKG-003|Feature / Conformance Rule}", tooltip="Prefect is declared only under the prefect optional extra as prefect==3.9.2."];
  "Excluded_Concerns_Non_Goals" [label="{Excluded Concerns (Non-Goals)|Feature / Explicit Non-Goal}", tooltip="Excludes: GPWCF Pipeline Root Entity/Aggregate, universal workflow adapter/plugin manager/runtime registry/scheduler/dispatcher/worker manager/deployment manager, generic business workflow definition,"];
  "Dependency_Architecture_Wave_6_Artifact_1" [label="{Dependency Architecture (Wave 6 Artifact 1)|Architectural Design / Feature|Diagnostic}", tooltip="Wave 6 detailed design (artifact 1) finalizing GPWCF dependency ownership and allowed/forbidden dependency directions across Core, optional Supporting Patterns, Prefect Integration, consumers, and the"];
  "Packaging_Architecture_Wave_6_Artifact_2" [label="{Packaging Architecture (Wave 6 Artifact 2)|Architectural Design / Feature}", tooltip="Wave 6 detailed design (artifact 2) defining the initial Python distribution model, build backend, project metadata, optional Prefect installation extra, dependency lock strategy, package discovery, a"];
  "Dependency_Graph_Nodes_and_Edges" [label="{Dependency Graph Nodes and Edges|Feature / Graph Model}", tooltip="Models dependency ownership and allowed/forbidden dependency directions across Core, optional Supporting Patterns, Prefect Integration, consumers, and SMRB development environment as a directed acycli"];
  "Required_Governing_Artifact_Changes_Filesystem_Architecture" [label="{Required Governing Artifact Changes - Filesystem Architecture|Feature / Change Control|Diagnostic}", tooltip="Allocate explicit public_api/core and public_api/integrations/prefect source packages; allocate documented optional public sub-surfaces for identities, diagnostics, and Supporting Patterns; keep inter"];
  "Required_Governing_Artifact_Changes_Framework_Module_Boundary_Model" [label="{Required Governing Artifact Changes - Framework Module Boundary Model|Feature / Change Control|Diagnostic}", tooltip="Add MOD-CORE-IDENTITIES and MOD-CORE-DIAGNOSTICS modules; map each Public API surface/sub-surface to its logical module owner; keep consumer and Prefect Integration ownership boundaries separate."];
  "Serialization_Failure_Semantics" [label="{Serialization Failure Semantics|Feature / Mapping Constraint}", tooltip="Serialization failure semantics for result persistence/retrieval: failures are operational failures, not domain outcomes; no universal serializer, codec registry, or artifact storage service is introd"];
  "Operational_Evidence_Retention" [label="{Operational Evidence Retention|Feature / Responsibility}", tooltip="Operational evidence retention and reporting responsibilities; concurrency evidence is exact and not generalized beyond the qualified two-worker profile; all open operational questions remain visible "];
  "Prefect_Integration_Package" [label="{Prefect Integration Package|Class / Component}", tooltip="The integration package's responsibility, ownership, and dependency boundary; owns Prefect integration concerns separate from Core, with Prefect as opt-in dependency never a Core dependency."];
  "Single_Distribution_Decision" [label="{Single-Distribution Decision|Feature / Packaging Decision}", tooltip="Selected option B: one gpwcf distribution containing Core and optional Prefect Integration package; Prefect declared only under optional [prefect] extra; Core base metadata has no third-party runtime "];
  "Core_Runtime_Standard_Library_Only" [label="{Core Runtime Standard-Library-Only|Feature / Constraint}", tooltip="Core runtime imports remain standard-library-only in the current baseline; Core is installable and importable without Prefect, Generator dependencies, or SMRB development assets."];
  "Integration_Boundary_Responsibility" [label="{Integration Boundary / Responsibility|Feature / Boundary}", tooltip="Defines the boundary that binds GPWCF domain contracts to Prefect-native execution constructs while preserving domain ownership, identities, results, and operational evidence as distinct from Prefect "];
  "Prefect_Integration_Public_API_Surface" [label="{Prefect Integration Public API Surface|Class / API Surface}", tooltip="Prefect Integration Public API (PUBLIC-PREFECT) with namespace gpwcf.public_api.integrations.prefect; exposes Prefect-specific binding/configuration/correlation/result retrieval API groups without exp"];
  "Two_Separate_Distributions_Option_Deferred" [label="{Two-Separate-Distributions Option (Deferred)|Feature / Packaging Option}", tooltip="Option A (deferred): Build gpwcf-core and gpwcf-prefect as separately published distributions from the initial release; requires coordinated multi-distribution build/release and version compatibility "];
  "Prefect_3_9_2_Optional_Runtime" [label="{Prefect 3.9.2 Optional Runtime|Feature / Dependency Rule}", tooltip="Prefect 3.9.2 is an accepted optional external runtime owned only by integrations.prefect; installed only through the optional Prefect profile; never a Core dependency."];
  "Core_Runtime_Dependency_Metadata" [label="{Core Runtime Dependency Metadata|Feature / Dependency Policy}", tooltip="Core base runtime dependencies remain empty; Core-only installation/import succeeds without Prefect, pygccxml, or Generator assets."];
  "Optional_Prefect_Extra" [label="{Optional Prefect Extra|Feature / Dependency Policy}", tooltip="Prefect declared only under the optional [prefect] extra as prefect==3.9.2; Prefect extra installs Prefect 3.9.2 and its minimized verified transitive closure."];

}
