digraph "03_Stage" {
  rankdir=TB;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  label="03 Stage Class Diagram";
  labelloc=t;

  "Stage_Execution_Context" [label="{Stage Execution Context|Feature / Contract Rule}", tooltip="Execution context passed to a Stage invocation as part of the callable boundary, distinct from the input value itself; owned by the Stage contract and not prescribed universally."];
  "Optional_Result_Contributions" [label="{Optional Result Contributions|Architectural Design / Feature}", tooltip="Wave 2 detailed design (artifact 3) defining a closed, typed, independently optional contribution model for the Step-level validation, error, and error-handling aggregates, preserving specialized resu"];
  "StageResult_Wave_1_Artifact_2" [label="{StageResult (Wave 1 Artifact 2)|Architectural Design / Feature}", tooltip="Wave 1 detailed design (artifact 2) defining a generic Stage invocation result envelope enabling caller and external workflow integration to retrieve and correlate a Stage result while preserving Stag"];
  "OptionalResultSlot" [label="{OptionalResultSlot|Class / Generic Type}", tooltip="Discriminated presence model where each contribution slot is independently present or absent. Absent and Present(None) are distinct; absence alone is not a universal status."];
  "StageResult_Contract" [label="{StageResult Contract|Class / Contract|StageResult}", tooltip="Runtime-independent Stage result contract owned by core.stage. Defines semantic boundary and ownership of StageResult; generic envelope fields for identity and correlation; separate typed slots for St"];
  "Stage_Result_Persistence_Retrieval" [label="{Stage Result Persistence/Retrieval|Feature / Integration Requirement}", tooltip="Stage result persistence/retrieval obligations using persist_result=True; Root waits for Deployment Flow Run terminal state and loads persisted Stage domain result through Prefect result reference; mu"];
  "Prefect_Result_Retrieval_API_Group" [label="{Prefect Result Retrieval API Group|Feature / API Group}", tooltip="Prefect Integration Public API group exposing supported result retrieval contract; persisted Stage domain results retrieved separately from Prefect State."];
  "Step_Lifecycle_RetainForReuse" [label="{Step Lifecycle - RetainForReuse|Feature / Lifecycle State}", tooltip="Step lifecycle disposition requesting continued availability for reuse. Complete only when reuse/reset/readiness/isolation conditions are satisfied; admission closure is staged during settlement/reset"];
  "Step_Lifecycle_TerminalRetirement" [label="{Step Lifecycle - TerminalRetirement|Feature / Lifecycle State}", tooltip="Step lifecycle disposition requesting terminal release. Complete only when admission is closed, all accepted invocations and obligations are settled, and required internal release is confirmed."];
  "Step_Admission_Boundary" [label="{Step Admission Boundary|Feature / Boundary}", tooltip="Linearizable ordering at the Step public boundary for admission of execute invocations and closure for RetainForReuse or TerminalRetirement. Invocations accepted before closure belong to the retiremen"];
  "Stage_Result_Construction_and_Preservation" [label="{Stage Result Construction and Preservation|Feature / Contract Rule|StageResult}", tooltip="Result construction, identity consistency, custody, immutability, and preservation invariants govern StageResult. A returned StageResult is distinct from a thrown invocation exception and from an exte"];
  "Stage_Error_Type_Definition_Registration" [label="{Stage Error Type Definition Registration|Feature / Responsibility|StageError\lStageErrorTypeDefinition}", tooltip="The concrete Stage owns specialized StageErrorTypeDefinition types and definitions for its Stage-level error domain. The Stage registers its StageErrorTypeDefinition instances through the StageErrorTy"];
  "Consumer_Implementation_Specialization_Points" [label="{Consumer Implementation / Specialization Points|Feature / API Surface}", tooltip="Defines what consumers may implement, customize, compose, and invoke; consumer owns Pipeline Root (no generic Root API created); consumer-specific Generator Stage/Step Models or business contracts exc"];
  "StageError_Occurrence" [label="{StageError Occurrence|Class / Entity|StageError}", tooltip="A Stage-owned component creates a StageError[TErrorOccurrenceContext] occurrence when an error arises within that component's Stage-owned responsibility. Stage Composition may create occurrences for e"];
  "Public_API_Architecture_Wave_6_Artifact_3" [label="{Public API Architecture (Wave 6 Artifact 3)|Architectural Design / Feature}", tooltip="Wave 6 detailed design (artifact 3) defining the stable, supported consumer-facing Public API surfaces of GPWCF Core and the optional Prefect Integration, including what consumers may implement/custom"];
  "Stage_Entity_Aggregate_Root" [label="{Stage Entity / Aggregate Root|Class / Entity}", tooltip="A bounded orchestration component that exposes a Stage-level interface to its consuming workflow and internally coordinates the Step Instances required by that Stage. Architectural level: stage, paren"];
  "Prefect_Dispatch_Tasks" [label="{Prefect Dispatch Tasks|Component / Mechanism}", tooltip="Narrow Prefect Task dispatch wrappers (invoke_stage, invoke_step) used to invoke native child Flow objects while preserving Prefect parent_task_run_id relationships. Carry no GPWCF business or composi"];
  "Stage_Error_Responsibilities" [label="{Stage Error Responsibilities|Feature / Responsibility|StageError}", tooltip="Definition ownership, registration, occurrence creation, flow consumption, and exception separation govern Stage-level error handling. Thrown exceptions remain distinct from StageError occurrences unl"];
  "Stage_Callable_Invocation_Acceptance_Boundary" [label="{Stage Callable Invocation Acceptance Boundary|Feature / Boundary|StageResult}", tooltip="Invocation acceptance, completion, returned-result, and thrown-exception distinctions define the Stage callable boundary. Each distinction is semantically separate; an exception preventing result retu"];
  "Stage_Callable_Functional_Binding_Obligations" [label="{Stage Callable Functional Binding Obligations|Feature / Pattern Binding}", tooltip="Functional binding obligations imposed on an external workflow integration for realizing the Stage callable boundary through a native external workflow element. Binding does not transfer domain semant"];
  "Stage_Callable_vs_Stage_Aggregate_Relationship" [label="{Stage Callable vs Stage Aggregate Relationship|Feature / Relationship}", tooltip="The Stage callable contract is the public invocation boundary of the Stage Aggregate. The Stage Aggregate owns Step membership, Stage Composition, flow semantics, transition meanings, and Stage Flow R"];
  "Synthetic_Deployment_Subflow_Invocation_Records" [label="{Synthetic Deployment/Subflow Invocation Records|Feature / Mechanism}", tooltip="Prefect-generated synthetic Task Runs that link deployment/subflow invocations to parent dispatch Task Runs; Stage Flow Run.parent_task_run_id points to the synthetic Task Run, not directly to the use"];
  "Result_Persistence_Retrieval_Mapping" [label="{Result Persistence/Retrieval Mapping|Feature / Mapping}", tooltip="Mapping of result persistence/retrieval across the integration boundary; persisted Stage domain results retrieved separately from Prefect State; serialization/persistence failures remain operational f"];
  "Stage_Callable_Stage_Facing_Public_API" [label="{Stage Callable Stage-Facing Public API|Feature / API Boundary}", tooltip="Stage-facing public API obligations and conformance requirements define how callers interact with the Stage through its public boundary. Core baseline uses standard library only and does not own Prefe"];
  "StageError_TErrorOccurrenceContext" [label="{StageError[TErrorOccurrenceContext]|Class / Generic Type|StageError\lStageErrorTypeDefinition\lTParams: TErrorOccurrenceContext}", tooltip="Stage-level error occurrence representing one actual occurrence of an error within a Stage; references exactly one registered StageErrorTypeDefinition."];
  "Stage_Callable_Exclusions" [label="{Stage Callable Exclusions|Feature / Explicit Non-Goal}", tooltip="Excludes Pipeline Root Entity, scheduler, dispatcher, worker manager, workflow graph executor, universal adapter, plugin manager, runtime registry, internal Stage Step topology, universal failure/retr"];
  "StageErrorTypeDefinitionRegistry_TErrorTypeDefinition" [label="{StageErrorTypeDefinitionRegistry[TErrorTypeDefinition]|Class / Generic Type|StageError\lStageErrorTypeDefinition\lTParams: TErrorTypeDefinition}", tooltip="Stage-level registry that stores and resolves StageErrorTypeDefinition instances for exactly one owning Stage; exclusively owned and allocated by the Pipeline per Stage."];
  "Stage_Result_vs_Prefect_State_Separation" [label="{Stage Result vs Prefect State Separation|Feature / Conceptual Distinction|StageResult}", tooltip="External workflow runtime State is operational execution evidence; it is not a GPWCF StageResult, Stage Flow Result, Stage output, or Stage domain outcome. Prefect State, Flow Run ID, Task Run ID, Dep"];
  "StageResult_Prefect_Persistence_and_Retrieval" [label="{StageResult Prefect Persistence and Retrieval|Feature / Integration Requirement}", tooltip="Requirements for Prefect result persistence and retrieval without making Prefect a Core dependency. Serialization and persistence are assigned to the selected integration without introducing a Core se"];
  "Core_Public_API_vs_Prefect_Integration_Public_API" [label="{Core Public API vs Prefect Integration Public API|Feature / API Boundary}", tooltip="Separable public API surfaces; Core must remain usable with Prefect absent. No Prefect types leak into Core API. Public API is an explicit curated stable boundary under public_api."];
  "Stage_Template_and_Concrete_Stage_Instance" [label="{Stage Template and Concrete Stage Instance|Class / Entity}", tooltip="Reusable structural template defining Stage responsibilities and relationships, and its concrete instantiation. Not limited to the thirteen Generator processing stages; applies to any concrete Stage I"];
  "Stage_Callable_Implementation_Gate" [label="{Stage Callable Implementation Gate|Feature / Change Control}", tooltip="Wave 1 detailed design proposal; becomes implementation constraint only after architecture review and explicit acceptance. Does not modify Stage_Level_Architecture.json, Step_Contract.json, Identity.j"];
  "Functional_Completeness_Condition" [label="{Functional Completeness Condition|Feature / Design Principle}", tooltip="Every function must have a clear contract, implementation, result, and defined lifecycle responsibility."];
  "Hierarchical_Completeness_Condition" [label="{Hierarchical Completeness Condition|Feature / Design Principle}", tooltip="Each level participates in hierarchical nesting within its own scope without requiring a custom workflow engine inside GPWCF."];
  "Dependency_Integrity_Condition" [label="{Dependency Integrity Condition|Feature / Design Principle}", tooltip="No reverse or circular dependencies between components."];
  "Runtime_Independence_Condition" [label="{Runtime Independence Condition|Feature / Design Principle}", tooltip="Core remains usable without requiring Prefect installation, while allowing Prefect integration when necessary."];
  "Stage_Responsibilities" [label="{Stage Responsibilities|Feature / Responsibility|StageError}", tooltip="Expose Stage contract to consuming workflow; own composition of Step Instances; coordinate Step invocation through Stage-facing callable contracts; define Stage-specific execution structure, dependenc"];
  "Step_TInput_TOutput" [label="{Step[TInput,TOutput]|Class / Generic Type|TParams: TInput,TOutput}", tooltip="Generic Step contract with type parameters TInput (input type accepted from owning Stage) and TOutput (output artifact type exposed to owning Stage). No common concrete types imposed across Steps."];
  "Step_Error_Handling_Contract" [label="{Step Error Handling Contract|Class / Component|THandlingOperationResult\lAssociation}", tooltip="Step-owned optional Supporting Unit callable (Error Handling Unit) that executes authorized handling operations against target occurrences/resources and produces THandlingOperationResult values until "];
  "Stage_Facade" [label="{Stage Facade|Class / Component}", tooltip="Provides the Stage-level boundary and interface through which the Pipeline invokes and receives results from the Stage. Presents the Stage execution contract without exposing internal Step composition"];
  "OperationEntryPublisher_Protocol" [label="{OperationEntryPublisher Protocol|Class / Contract|ErrorHandlingOperationEntry}", tooltip="Step-specific composition-owned reserve/publish/status/release protocol for ErrorHandlingOperationEntry delivery; atomic acceptance linearization, complete-entry retention capacity, per-invocation Pub"];
  "PublicationReservation" [label="{PublicationReservation|Class / Entity|OperationEntryPublisher}", tooltip="Opaque, single-use publication capability issued by the OperationEntryPublisher; reserves complete-entry retention capacity and handoff path for exactly one Handling Operation Attempt; states Reserved"];
  "Single_Step_Publication_Specialization_Contract" [label="{Single Step Publication Specialization Contract|Class / Contract|OperationEntryPublisher}", tooltip="Mandatory per-Step concrete instantiation of publication protocol representations, Recovery Owner and recovery procedure, identity rules, publication-status retention, and end-to-end state/custody tra"];
  "GPWCF_Distribution_Shape" [label="{GPWCF Distribution Shape|Feature / Packaging}", tooltip="One GPWCF distribution with dependency-free Core base and optional Prefect extra. Core installs and imports without Prefect; optional extra supplies Prefect Integration runtime. prefect==3.9.2 remains"];
  "StageComposition" [label="{StageComposition|Class / Component}", tooltip="Owns semantic composition and flow rules of Step Instances belonging to the Stage; coordinates their contract-level participation and result collection while allowing an external Workflow Framework to"];
  "Stage_Callable_Stage_Invocation_Stage_Result_Contract_Group" [label="{Stage Callable / Stage Invocation / Stage Result Contract Group|Feature / API Contract Group|StageResult\lStageInvocation}", tooltip="Core Public API contract group covering StageCallable, StageInvocation, and StageResult; readiness gaps resolved according to Waves 1-4."];
  "Stage_Flow_Deployment_Binding" [label="{Stage Flow/Deployment Binding|Feature / Pattern Binding}", tooltip="Native Prefect realization of Stage execution as Stage Flow/Deployment using the accepted run_deployment(..., as_subflow=True) profile from PHASE-02 topology qualification."];
  "run_deployment_as_subflow_True_Profile" [label="{run_deployment(as_subflow=True) Profile|Feature / Mechanism}", tooltip="Accepted Stage invocation mechanism from PHASE-02: Root-owned Prefect dispatch Task calls run_deployment(..., as_subflow=True), creating a deployment Flow Run with synthetic parent linkage and explici"];
  "StageCallable_Wave_1_Artifact_1" [label="{StageCallable (Wave 1 Artifact 1)|Architectural Design / Feature}", tooltip="Wave 1 detailed design (artifact 1) defining the framework-owned, workflow-runtime-independent callable boundary of a GPWCF Stage. Makes a concrete Stage invocable as one bounded functional unit by a "];
  "StageCallableContract" [label="{StageCallableContract|Class / Contract}", tooltip="The public invocation boundary of the Stage Aggregate; does not transfer Stage responsibilities to caller or external runtime. Defines semantic meaning, minimum invocation information, input/execution"];
  "Step_Composition" [label="{Step Composition|Class / Component}", tooltip="The Step-owned internal composition boundary responsible for coordinating pluggable processing and supporting components required by one concrete Step. Architectural level: stage-step, owning level: S"];
  "Step_Subflow_Binding" [label="{Step Subflow Binding|Feature / Pattern Binding}", tooltip="Native Prefect realization of Step execution as a Step Subflow; Stage-to-Step dispatch through a Prefect Task invoking a native Step Subflow while preserving the public Step callable boundary and nati"];
  "StageInvocation" [label="{StageInvocation|Class / Entity}", tooltip="Typed invocation envelope carrying minimum information required to invoke a concrete Stage. Separates Stage identity, Stage invocation identity, caller correlation identity, and external runtime ident"];
  "Stage_Input_Output_Typing_Boundary" [label="{Stage Input / Output Typing Boundary|Feature / Contract Rule}", tooltip="Stage input accepted from consuming workflow and output returned to consuming workflow are each typed per concrete Stage specialization. No universal schema for concrete Stage inputs, outputs, Stage F"];
  "Step_Execution_Result" [label="{Step Execution Result|Architectural Design / Feature}", tooltip="Wave 2 detailed design (artifact 2) defining the Step-level structured result returned to Stage, preserving the processing artifact and independently optional Step-specialized aggregates while adding "];

  "Optional_Result_Contributions" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Lifecycle_RetainForReuse" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Lifecycle_TerminalRetirement" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Admission_Boundary" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Error_Type_Definition_Registration" -> "StageErrorTypeDefinitionRegistry_TErrorTypeDefinition" [label="assoc", style=dashed];
  "Consumer_Implementation_Specialization_Points" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "StageError_Occurrence" -> "StageError_TErrorOccurrenceContext" [label="assoc", style=dashed];
  "Stage_Entity_Aggregate_Root" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Error_Responsibilities" -> "StageError_TErrorOccurrenceContext" [label="assoc", style=dashed];
  "Stage_Callable_vs_Stage_Aggregate_Relationship" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Callable_Exclusions" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Responsibilities" -> "StageError_TErrorOccurrenceContext" [label="assoc", style=dashed];
  "Stage_Responsibilities" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Error_Handling_Contract" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Facade" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "OperationEntryPublisher_Protocol" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Single_Step_Publication_Specialization_Contract" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "StageComposition" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Stage_Callable_Stage_Invocation_Stage_Result_Contract_Group" -> "StageInvocation" [label="assoc", style=dashed];
  "StageCallable_Wave_1_Artifact_1" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Composition" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Subflow_Binding" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
  "Step_Execution_Result" -> "Step_TInput_TOutput" [label="assoc", style=dashed];
}
