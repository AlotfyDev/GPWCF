digraph "10_Dependency_Packaging_Public_API" {
  rankdir=TB;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  label="10 Dependency Packaging Public API Class Diagram";
  labelloc=t;

  "Build_Development_Runtime_Lock_Separation" [label="{Build/Development/Runtime Lock Separation|Feature / Dependency Policy}", tooltip="Build-system dependencies isolated from runtime dependencies; build/development/test/verification tools excluded from runtime metadata; separate lock profiles for each category."];
  "py_typed_Inclusion" [label="{py.typed Inclusion|Feature / Package Policy}", tooltip="The wheel includes py.typed; package markers and exports not created before Wave 6 Public API design acceptance."];
  "Dependency_Closure" [label="{Dependency Closure|Feature / Policy}", tooltip="Dependency closure and release gates: dependency graph is acyclic and all forbidden dependency directions remain prohibited; every runtime/build/development dependency has one explicit owner."];
  "Wheel_sdist_Exclusion_Policy" [label="{Wheel/sdist Exclusion Policy|Feature / Package Policy}", tooltip="The wheel excludes docs, PoC, dependencies, virtual environment, and consumer-specific assets; only accepted baseline package markers materialized."];
  "Clean_Installation_Build_Verification_Profiles" [label="{Clean Installation/Build Verification Profiles|Feature / Verification}", tooltip="Installation commands and packaging verification profiles defined; wheel/sdist and import-isolation verification profiles established; clean isolated build verification is a release gate."];
  "Setuptools_Build_Backend" [label="{Setuptools Build Backend|Feature / Build Policy}", tooltip="Record setuptools==84.2.1 / setuptools.build_meta as isolated build-system dependency; build backend dependencies remain isolated from runtime dependencies."];
  "Conformance_Requirement_PKG_002" [label="{Conformance Requirement PKG-002|Feature / Conformance Rule}", tooltip="Core base runtime dependencies remain empty."];
  "Compatibility_Versioning_Policy" [label="{Compatibility / Versioning Policy|Feature / API Policy}", tooltip="Public API compatibility and versioning policy defines stability guarantees across version changes; every public symbol has a source contract/design owner and versioning classification."];
  "Public_API_Readiness_Gaps_Resolved_by_Waves_1_4" [label="{Public API Readiness Gaps Resolved by Waves 1-4|Feature / Change Control}", tooltip="Update Public API readiness gaps resolved by Waves 1-4 while retaining production integration/failure qualification gates; exact public import/export names detailed in 16.00_Public_API_Architecture.js"];
  "Change_Control_Implementation_Gate" [label="{Change Control / Implementation Gate|Feature / Change Control}", tooltip="Wave 6 packaging proposal; becomes implementation constraint only after review and explicit acceptance; do not create pyproject.toml until all Wave 6 artifacts and governing-artifact reconciliation ar"];
  "Dependency_Owner_and_Module_Lists" [label="{Dependency Owner and Module Lists|Feature / Change Control|Diagnostic}", tooltip="Update dependency owner/module lists and dependency graph with core.identities and core.diagnostics; records required reconciliation changes to Dependency_and_Public_API_Architecture.json, Framework_M"];
  "Public_API_Conformance_Tests" [label="{Public API Conformance Tests|Feature / Verification}", tooltip="Public API conformance tests verify supported exports, not private imports; tests validate public API manifest matches exported __all__ symbols, module ownership maps to Framework_Module_Boundary_Mode"];
  "Wave_6_Implementation_Gate" [label="{Wave 6 Implementation Gate|Feature / Change Control}", tooltip="Do not create pyproject.toml or install new project build dependencies until all Wave 6 artifacts and governing-artifact reconciliation are accepted; next step: design 15,00_Packaging.json."];
  "Change_Control_Implementation_Gate" [label="{Change Control / Implementation Gate|Feature / Change Control}", tooltip="Wave 6 Public API proposal; becomes supported consumer contract only after architecture review, governing-artifact reconciliation, and implementation conformance tests; do not create public_api packag"];
  "Dependency_Ownership_Principle" [label="{Dependency Ownership Principle|Feature / Governing Principle}", tooltip="Dependency ownership follows semantic and operational responsibility, not repository proximity or current developer environment installation."];
  "PEP_517_518_Build_System_Declaration" [label="{PEP 517/518 Build-System Declaration|Feature / Build Policy}", tooltip="Build-system declaration following PEP 517/518; declares build backend and isolated build requirements separate from runtime dependencies."];
  "Public_API_Governing_Decision_Principle" [label="{Public API Governing Decision Principle|Feature / Governing Rule}", tooltip="Public API is the stable supported consumer contract boundary; it is not merely an __init__.py re-export list or a convenient alias for internal modules; public symbols are explicit, curated, versione"];
  "Optional_Supporting_Pattern_Dependencies" [label="{Optional Supporting Pattern Dependencies|Feature / Dependency Rule}", tooltip="Optional Supporting Patterns remain separately importable and are required only when selected by a concrete Step; consumers that do not select them incur no mandatory pattern package import."];
  "PEP_621_Project_Metadata" [label="{PEP 621 Project Metadata|Feature / Build Policy}", tooltip="Project metadata following PEP 621 in [project] table of pyproject.toml; provides standardized project metadata declaration."];
  "Generator_Extraction_Dependencies" [label="{Generator Extraction Dependencies|Feature / Dependency Rule}", tooltip="Generator extraction dependencies remain consumer-owned; GPWCF does not own or impose Generator-specific dependency closures."];
  "Setuptools_Build_Backend" [label="{Setuptools Build Backend|Feature / Build Policy}", tooltip="Build backend setuptools.build_meta pinned to setuptools==84.2.1, subject to clean CPython 3.15.1 build verification; supports wheel/sdist build hooks."];
  "SMRB_dependencies_and_Shared_env_Treatment" [label="{SMRB .dependencies and Shared .env Treatment|Feature / Environment Rule}", tooltip="SMRB .dependencies and shared .env remain the solution-level development dependency-management mechanism; GPWCF must not create a parallel local dependency bundle or environment; no GPWCF-local .depen"];
  "src_gpwcf_Source_Layout" [label="{src/gpwcf Source Layout|Feature / Package Layout}", tooltip="Package uses src/gpwcf layout with PEP 621 metadata in pyproject.toml; source package discovery and package-data policy defined for the distribution."];
  "Canonical_Identities_Contract_Group" [label="{Canonical Identities Contract Group|Feature / API Contract Group}", tooltip="Core Public API contract group covering canonical identity value types; provided through core.identities module as narrow dependency-free nominal identity types."];
  "Core_Identities_Module" [label="{Core Identities Module|Class / Module}", tooltip="core.identities is a narrow dependency-free module for nominal identity value types only; justified as part of Wave 6 dependency architecture."];
  "Optional_Diagnostics_Public_Sub_Surface" [label="{Optional Diagnostics Public Sub-Surface|Feature / API Sub-Surface|Diagnostic}", tooltip="Optional Diagnostics public sub-surface under Core Public API; core.diagnostics module is optional and does not become a universal Error Model."];

}
